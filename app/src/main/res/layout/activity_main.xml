<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/container_m"
        android:padding="5dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="50dp"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:orientation="horizontal"
                android:background="@drawable/container_m"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/myAvatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/container_m"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="5dp">
                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:fontFamily="@font/lowerpixel"
                        android:textColor="@color/yellow_main"/>
                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:fontFamily="@font/lowerpixel"
                        android:textColor="@color/yellow_main"/>
                    <TextView
                        android:id="@+id/codeTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:fontFamily="@font/lowerpixel"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:paddingLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:background="@color/yellow_main"
                        android:text="CODE :"/>
                </LinearLayout>

            </LinearLayout>
            <LinearLayout
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_margin="3dp"
                android:background="@drawable/container_m">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="17dp"
                    android:text="vox"
                    android:background="@color/yellow_main"
                    android:paddingLeft="5dp"
                    android:fontFamily="@font/pixelbold"
                    android:textSize="18sp"
                    android:textColor="@color/black"/>
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:src="@drawable/vox_icon" />

            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="3dp"
            android:gravity="center_vertical"
            android:background="@drawable/container_m">
            <TextView
                android:id="@+id/tvCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="50sp"
                android:textColor="@color/yellow_main"
                android:text="03:30"
                android:layout_marginLeft="10dp"
                android:fontFamily="@font/lowerpixel"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_margin="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:id="@+id/tvWeather"
                    android:layout_weight="1"
                    android:text="@string/weather_not_found"
                    android:textSize="15sp"
                    android:textColor="@color/yellow_main"
                    android:fontFamily="@font/lowerpixel"/>
                <TextView
                    android:id="@+id/tvCurrentMeridian"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PM"
                    android:textSize="15sp"
                    android:textColor="@color/yellow_main"
                    android:fontFamily="@font/lowerpixel"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/yellow_main">

                <ImageView
                    android:id="@+id/loadBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="8dp"
                    android:src="@drawable/load1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:id="@+id/tvStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stats loading..."
                android:layout_marginLeft="15dp"
                android:textColor="@color/yellow_main"
                android:fontFamily="@font/lowerpixel"/>


        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="3dp"
            android:gravity="center_vertical"
            android:background="@drawable/container_m">
            <EditText
                android:id="@+id/etTask"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textSize="18sp"
                android:paddingLeft="10dp"
                android:layout_height="wrap_content"
                android:textColor="@color/yellow_secondary"
                android:textColorHint="@color/yellow_secondary"
                android:fontFamily="@font/lowerpixel"
                android:hint="Enter task"/>
                <TextView
                    android:id="@+id/btnAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add"
                    android:soundEffectsEnabled="false"
                    android:textStyle="bold"
                    android:padding="10dp"
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/lowerpixel"
                    android:background="@color/yellow_main"/>




        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTasks"
            android:background="@drawable/container_m"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="3dp"
            android:layout_weight="1"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>