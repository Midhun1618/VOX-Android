<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.MainActivity"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/container_m"
        android:padding="5dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="50dp"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:orientation="horizontal"
                android:background="@drawable/container_m"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/myAvatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/container_m"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="5dp">
                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:fontFamily="@font/lowerpixel"
                        android:textColor="@color/yellow_main"/>
                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:fontFamily="@font/lowerpixel"
                        android:textColor="@color/yellow_main"/>
                    <TextView
                        android:id="@+id/codeTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:fontFamily="@font/lowerpixel"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:paddingLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:background="@color/yellow_main"
                        android:text="CODE :"/>
                </LinearLayout>

            </LinearLayout>
            <LinearLayout
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_margin="3dp"
                android:background="@drawable/container_m">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="17dp"
                    android:text="vox"
                    android:background="@color/yellow_main"
                    android:paddingLeft="5dp"
                    android:fontFamily="@font/pixelbold"
                    android:textSize="18sp"
                    android:textColor="@color/black"/>
                <ImageView
                    android:id="@+id/voxEmote"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:src="@drawable/vox_icon_neutral" />

            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="3dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_weight="3"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/container_m">
            <TextView
                android:id="@+id/tvCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="50sp"
                android:textColor="@color/yellow_main"
                android:text="03:30"
                android:layout_marginLeft="10dp"
                android:fontFamily="@font/lowerpixel"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_margin="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:id="@+id/tvWeather"
                    android:layout_weight="1"
                    android:text="@string/weather_not_found"
                    android:textSize="15sp"
                    android:textColor="@color/yellow_main"
                    android:fontFamily="@font/lowerpixel"/>
                <TextView
                    android:id="@+id/tvCurrentMeridian"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PM"
                    android:textSize="15sp"
                    android:textColor="@color/yellow_main"
                    android:fontFamily="@font/lowerpixel"/>
            </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_weight="1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:layout_marginHorizontal="5dp"
                android:orientation="vertical"
                android:background="@drawable/container_m">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FOCUS"
                    android:textAlignment="center"
                    android:textSize="10sp"
                    android:padding="4dp"
                    android:background="@color/yellow_main"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:fontFamily="@font/highlight"/>
                <TextView
                    android:id="@+id/tvDisciplie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00%"
                    android:textSize="30sp"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/yellow_main"
                    android:textStyle="bold"
                    android:fontFamily="@font/lowerpixel"/>

            </LinearLayout>
            <LinearLayout
                android:layout_weight="2"
                android:layout_width="wrap_content"
                android:gravity="center"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@drawable/container_m">
            <TextView
                android:id="@+id/tvStats"
                android:layout_width="wrap_content"
                android:paddingHorizontal="10dp"
                android:layout_height="wrap_content"
                android:text="Stats loading..."
                android:textColor="@color/yellow_main"
                android:fontFamily="@font/lowerpixel"/>
            </LinearLayout>



        </LinearLayout>
        <LinearLayout
            android:id="@+id/clipboardPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="3dp"
            android:background="@drawable/container_m"
            android:visibility="visible">

            <TextView
                android:id="@+id/tvLatestFromPc"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="Nothing received yet"
                android:textSize="18sp"
                android:textColor="@color/yellow_main"
                android:fontFamily="@font/lowerpixel"
                android:textStyle="italic"
                android:padding="8dp"
                android:visibility="visible"/>

            <TextView
                android:id="@+id/btnCopyToPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COPY"
                android:textStyle="bold"
                android:clickable="true"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:fontFamily="@font/lowerpixel"
                android:background="@color/yellow_main"
                android:padding="8dp"
                android:visibility="visible"/>

            <EditText
                android:id="@+id/etManualPaste"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:hint="Paste text here"
                android:textStyle="italic"
                android:textColor="@color/yellow_main"
                android:textSize="18sp"
                android:fontFamily="@font/lowerpixel"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/btnUploadClipboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lowerpixel"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:textStyle="italic"
                android:background="@color/yellow_main"
                android:text="SYNC"
                android:padding="8dp"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/backClipboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lowerpixel"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:textStyle="italic"
                android:background="@color/yellow_main30"
                android:text="X"
                android:padding="8dp"
                android:visibility="gone"/>



        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="3dp"
            android:gravity="center_vertical"
            android:background="@drawable/container_m">
            <EditText
                android:id="@+id/etTask"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textSize="18sp"
                android:paddingLeft="10dp"
                android:layout_height="wrap_content"
                android:textColor="@color/yellow_secondary"
                android:textColorHint="@color/yellow_secondary"
                android:fontFamily="@font/lowerpixel"
                android:hint="Enter task"/>
                <TextView
                    android:id="@+id/btnAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add"
                    android:soundEffectsEnabled="false"
                    android:textStyle="bold"
                    android:padding="10dp"
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/lowerpixel"
                    android:background="@color/yellow_main"/>




        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_marginTop="3dp"
            android:layout_marginHorizontal="3dp"
            android:layout_height="wrap_content">

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:id="@+id/btnActive"
                android:clickable="true"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:background="@color/yellow_main"
                android:fontFamily="@font/pixelbold"
                android:paddingVertical="5dp"
                android:paddingHorizontal="10dp"
                android:text="TASKS"
                android:layout_marginRight="2dp"/>
            <TextView
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:id="@+id/btnPast"
                android:clickable="true"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:background="@color/yellow_main30"
                android:fontFamily="@font/pixelbold"
                android:paddingVertical="5dp"
                android:paddingHorizontal="10dp"
                android:text="HISTORY"
                android:layout_marginRight="2dp"/>
            <TextView
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:id="@+id/btnReminder"
                android:clickable="true"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:background="@color/yellow_main30"
                android:fontFamily="@font/pixelbold"
                android:paddingVertical="5dp"
                android:paddingHorizontal="10dp"
                android:text="REMINDERS"/>

        </LinearLayout>

        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/container_m"
            android:layout_weight="1"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>