<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/black"
    android:foreground="@drawable/container_m">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="V O X   SETTINGS"
        android:padding="8dp"
        android:fontFamily="@font/pixelbold"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:background="@color/yellow_main"
        android:layout_marginBottom="8dp"/>
    <Switch
        android:id="@+id/switch_vox"
        android:layout_margin="10dp"
        android:fontFamily="@font/lowerpixel"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:textColor="@color/yellow_main"
        android:text="Enable VOX Assistant"/>


</LinearLayout>
