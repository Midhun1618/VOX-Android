<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/black"
    android:foreground="@drawable/container_m">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Task Completed?"
        android:fontFamily="@font/lowerpixel"
        android:textSize="18sp"
        android:textColor="@color/yellow_main"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Have you done this task?"
        android:textSize="15sp"
        android:fontFamily="@font/lowerpixel"
        android:textColor="@color/yellow_main"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnNo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginRight="3dp"
            android:layout_height="match_parent"
            android:textSize="18sp"
            android:text="Not yet"
            android:soundEffectsEnabled="false"
            android:fontFamily="@font/lowerpixel"
            android:textColor="@color/yellow_main"
            android:padding="8dp"
            android:textAlignment="center"
            android:background="@drawable/container_m"/>
        <TextView
            android:id="@+id/btnYes"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginRight="3dp"
            android:layout_height="match_parent"
            android:textSize="18sp"
            android:textAlignment="center"
            android:text="Yes"
            android:soundEffectsEnabled="false"
            android:textStyle="bold"
            android:fontFamily="@font/lowerpixel"
            android:textColor="@color/black"
            android:padding="8dp"
            android:background="@color/yellow_main"/>

    </LinearLayout>

</LinearLayout>
