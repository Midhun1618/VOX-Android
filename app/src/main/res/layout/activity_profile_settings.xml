<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="@color/black">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginHorizontal="35dp"
        android:paddingBottom="20dp"
        android:background="@drawable/container_m">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:paddingLeft="15dp"
            android:background="@color/yellow_main"
            android:fontFamily="@font/pixelbold"
            android:text="Profile"
            android:textSize="25sp"
            android:layout_marginBottom="30dp"/>
        <ImageView
            android:id="@+id/avatar"
            android:src="@drawable/avatar1"
            android:background="@drawable/container_x"
            android:layout_margin="2dp"
            android:layout_width="100dp"
            android:layout_height="100dp"/>
        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Your Avatar"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:background="@color/yellow_main"
            android:fontFamily="@font/lowerpixel"
            android:textAlignment="center"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="32dp">

            <ImageView
                android:id="@+id/avatar0"
                android:src="@drawable/avatar1"
                android:soundEffectsEnabled="false"
                android:background="@drawable/container_x"
                android:layout_margin="2dp"
                android:layout_width="50dp"
                android:layout_height="50dp"/>

            <ImageView
                android:id="@+id/avatar1"
                android:layout_margin="2dp"
                android:soundEffectsEnabled="false"
                android:src="@drawable/avatar2"
                android:background="@drawable/container_m"
                android:layout_width="50dp"
                android:layout_height="50dp"/>

            <ImageView
                android:id="@+id/avatar2"
                android:layout_margin="2dp"
                android:soundEffectsEnabled="false"
                android:src="@drawable/avatar3"
                android:background="@drawable/container_m"
                android:layout_width="50dp"
                android:layout_height="50dp"/>
            <ImageView
                android:id="@+id/avatar3"
                android:layout_margin="2dp"
                android:soundEffectsEnabled="false"
                android:src="@drawable/avatar4"
                android:background="@drawable/container_m"
                android:layout_width="50dp"
                android:layout_height="50dp"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/avatar4"
                android:src="@drawable/avatar5"
                android:soundEffectsEnabled="false"
                android:background="@drawable/container_m"
                android:layout_margin="2dp"
                android:layout_width="50dp"
                android:layout_height="50dp"/>

            <ImageView
                android:id="@+id/avatar5"
                android:layout_margin="2dp"
                android:soundEffectsEnabled="false"
                android:src="@drawable/avatar6"
                android:background="@drawable/container_m"
                android:layout_width="50dp"
                android:layout_height="50dp"/>

            <ImageView
                android:id="@+id/avatar6"
                android:layout_margin="2dp"
                android:soundEffectsEnabled="false"
                android:src="@drawable/avatar7"
                android:background="@drawable/container_m"
                android:layout_width="50dp"
                android:layout_height="50dp"/>
            <ImageView
                android:id="@+id/avatar7"
                android:layout_margin="2dp"
                android:soundEffectsEnabled="false"
                android:src="@drawable/avatar8"
                android:background="@drawable/container_m"
                android:layout_width="50dp"
                android:layout_height="50dp"/>

        </LinearLayout>

        <EditText
            android:id="@+id/etUsername"
            android:layout_width="216dp"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:layout_marginHorizontal="20dp"
            android:hint="Enter username"
            android:textColor="@color/yellow_main"
            android:textSize="18sp"
            android:fontFamily="@font/lowerpixel"
            android:textColorHint="@color/yellow_secondary"
            android:padding="5dp"
            android:background="@drawable/container_m"/>



        <TextView
            android:id="@+id/btnSave"
            android:layout_width="216dp"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:text="CREATE"
            android:soundEffectsEnabled="false"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:background="@color/yellow_main"
            android:fontFamily="@font/lowerpixel"
            android:paddingVertical="6dp"
            android:paddingHorizontal="10dp"
            android:layout_marginTop="32dp"/>
    </LinearLayout>

</LinearLayout>
